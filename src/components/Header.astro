---
import { SITE } from '../config/site.mjs';
import { NAV } from '../data/content.mjs';
import { ICONS } from '../data/icons.mjs';
import logoLight from '../assets/brand/logo-yatay-light.svg?url';
import logoDark from '../assets/brand/logo-yatay-dark.svg?url';
interface Props { path: string; minimal?: boolean; }
const { path, minimal = false } = Astro.props;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class="site-header" id="site-header">
  <div class="wrap hdr">
    <a class="brand" href="/" aria-label="Nova Gayrimenkul ana sayfa">
      <img class="logo-light" src={logoLight} alt="Nova Gayrimenkul" width="232" height="72" />
      <img class="logo-dark" src={logoDark} alt="Nova Gayrimenkul" width="232" height="72" />
    </a>
    {!minimal && <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Menüyü aç">
      <span></span>
    </button>}
    {!minimal && <nav class="nav" id="site-nav" aria-label="Ana menü">
      <ul>
        {NAV.map((item, i) =>
          item.children ? (
            <li class="has-sub">
              <button type="button" aria-expanded="false" aria-controls={`sub-${i}`}>
                {item.label}<Fragment set:html={ICONS.chevron} />
              </button>
              <ul class="sub" id={`sub-${i}`}>
                {item.children.map((c) => (
                  <li><a href={c.href} aria-current={isCurrent(c.href) ? 'page' : undefined}>{c.label}</a></li>
                ))}
              </ul>
            </li>
          ) : (
            <li><a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a></li>
          ),
        )}
      </ul>
      <div class="nav-extra">
        <a class="btn" href="/iletisim/#gorusme">Görüşme Planlayın</a>
        <a class="btn btn--line" href={SITE.phoneHref} data-loc="menu">{SITE.phoneDisplay}</a>
      </div>
    </nav>}
    <div class={`hdr-cta ${minimal ? 'hdr-cta--min' : ''}`}>
      <a class="hdr-phone" href={SITE.phoneHref} data-loc="header" aria-label={`Telefon: ${SITE.phoneDisplay}`}>
        <Fragment set:html={ICONS.phone} /><span>{SITE.phoneDisplay}</span>
      </a>
      {!minimal && <a class="btn" href="/iletisim/#gorusme">Görüşme Planlayın</a>}
    </div>
  </div>
</header>
