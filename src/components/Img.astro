---
/**
 * Optimize görsel: AVIF + WebP + JPG yedeği, farklı genişlikler, boyutlar önceden ayrılır (CLS önlenir).
 * Kullanım: <Img name="villa-havuz" alt="..." sizes="(max-width: 860px) 100vw, 50vw" />
 */
import { Picture } from 'astro:assets';
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/*.{png,jpg,jpeg,webp}', { eager: true });

interface Props {
  name: string;
  alt: string;
  sizes?: string;
  widths?: number[];
  loading?: 'lazy' | 'eager';
  priority?: boolean;
  class?: string;
}
const { name, alt, sizes = '100vw', widths = [480, 640, 828, 1080, 1440, 1600], loading = 'lazy', priority = false, class: cls } = Astro.props;
const key = Object.keys(images).find((k) => k.split('/').pop()!.replace(/\.[^.]+$/, '') === name);
if (!key) throw new Error(`Görsel bulunamadı: ${name}`);
const src = images[key].default;
const w = widths.filter((x) => x <= src.width);
---
<Picture
  src={src}
  alt={alt}
  widths={w.length ? w : [src.width]}
  sizes={sizes}
  formats={['avif', 'webp']}
  fallbackFormat="jpg"
  quality={priority ? 82 : 78}
  loading={priority ? 'eager' : loading}
  decoding={priority ? 'sync' : 'async'}
  fetchpriority={priority ? 'high' : 'auto'}
  class={cls}
/>
