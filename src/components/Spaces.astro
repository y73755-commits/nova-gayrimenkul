---
import Img from './Img.astro';
import { ALANLAR } from '../data/content.mjs';
interface Props { headingLevel?: 'h3' | 'h2'; }
const { headingLevel = 'h3' } = Astro.props;
const H = headingLevel;
---
<div class="spaces">
  {ALANLAR.map((a, i) => (
    <article class="space reveal">
      <div class="space__img">
        <Img name={a.gorsel} alt={a.alt} sizes={i === 0 || i === 3 ? '(max-width: 860px) 100vw, 58vw' : '(max-width: 860px) 100vw, 42vw'} />
      </div>
      <div class="space__body">
        <H><a href={`/yasam-alanlari/#${a.id}`}>{a.baslik}</a></H>
        <p>{a.kisa}</p>
        <a class="link" href={`/iletisim/?konu=${a.id === 'daire-rezidans' ? 'daire-rezidans' : a.id}#gorusme`}>{a.baslik} için görüşme talebi</a>
      </div>
    </article>
  ))}
</div>
<p class="concept-note">Görseller mimari konsept ve yaşam alanı sunumu amacıyla hazırlanmıştır.</p>
