---
import '@fontsource-variable/jost';
import '@fontsource-variable/bodoni-moda';
import '../styles/global.css';
import { SITE, absoluteUrl, waUrl, waMessage } from '../config/site.mjs';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Consent from '../components/Consent.astro';
import { ICONS } from '../data/icons.mjs';

interface Props {
  title: string;
  description: string;
  path: string;
  ogImage?: string;
  noindex?: boolean;
  /** WhatsApp hazır mesajındaki konu: "… hakkında görüşmek istiyorum." */
  waTopic?: string;
  /** true → başlık şeffaf değil, açık zeminli sayfa başlığı */
  light?: boolean;
  jsonLd?: object[];
  ogType?: string;
  /** Reklam açılış sayfaları: menüsüz sade başlık */
  minimal?: boolean;
}
const { title, description, path, ogImage = SITE.ogImage, noindex = false, waTopic = 'gayrimenkul danışmanlığı', light = false, jsonLd = [], ogType = 'website', minimal = false } = Astro.props;
const canonical = absoluteUrl(path);
const fullTitle = path === '/' ? title : `${title} | ${SITE.name}`;
const og = absoluteUrl(ogImage);
const waHref = waUrl(waMessage(waTopic));
const clientConfig = {
  formEndpoint: SITE.formEndpoint,
  whatsappNumber: SITE.whatsappNumber,
  phoneHref: SITE.phoneHref,
  consentMode: SITE.consentMode,
  gtmId: SITE.gtmId,
};
const gtmBoot = { gtmId: SITE.gtmId, consentMode: SITE.consentMode, hosts: SITE.productionHosts };
---
<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <meta name="robots" content="index, follow, max-image-preview:large" />}
    <meta name="theme-color" content="#101114" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Nova Gayrimenkul — seçkin yaşam alanları için gayrimenkul danışmanlığı" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}

    <!-- Consent Mode v2: her şey varsayılan olarak reddedilmiş başlar; GTM yalnızca canlı alan adında ve izinle yüklenir -->
    <script is:inline define:vars={{ boot: gtmBoot }}>
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () { window.dataLayer.push(arguments); };
      var stored = null;
      try { stored = JSON.parse(localStorage.getItem('nova.consent.v1') || 'null'); } catch (e) {}
      var internal = false;
      try {
        var q = new URLSearchParams(location.search).get('nova_test');
        if (q === '1') localStorage.setItem('nova.internal', '1');
        if (q === '0') localStorage.removeItem('nova.internal');
        internal = localStorage.getItem('nova.internal') === '1';
      } catch (e) {}
      gtag('consent', 'default', {
        ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied',
        analytics_storage: 'denied', functionality_storage: 'granted', security_storage: 'granted',
        wait_for_update: 500,
      });
      gtag('set', 'ads_data_redaction', true);
      if (stored) {
        gtag('consent', 'update', {
          analytics_storage: stored.analytics ? 'granted' : 'denied',
          ad_storage: stored.ads ? 'granted' : 'denied',
          ad_user_data: stored.ads ? 'granted' : 'denied',
          ad_personalization: stored.ads ? 'granted' : 'denied',
        });
      }
      var prod = boot.hosts.indexOf(location.hostname) !== -1;
      window.__nova = { prod: prod, internal: internal, gtmId: boot.gtmId, consentMode: boot.consentMode, gtmLoaded: false };
      window.__novaLoadGTM = function () {
        var n = window.__nova;
        if (!n.gtmId || !n.prod || n.internal || n.gtmLoaded) return false;
        n.gtmLoaded = true;
        window.dataLayer.push({ 'gtm.start': Date.now(), event: 'gtm.js' });
        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtm.js?id=' + encodeURIComponent(n.gtmId);
        document.head.appendChild(s);
        return true;
      };
      if (boot.consentMode === 'advanced' || (stored && (stored.analytics || stored.ads))) window.__novaLoadGTM();
      document.documentElement.classList.add('js');
    </script>
    <script type="application/json" id="nova-config" set:html={JSON.stringify(clientConfig)} />
  </head>
  <body class={light ? 'page-light' : ''} data-wa-topic={waTopic}>
    <a class="skip-link" href="#icerik">İçeriğe geç</a>
    <Header path={path} minimal={minimal} />
    <main id="icerik">
      <slot />
    </main>
    <Footer />

    <a class="wa-float" href={waHref} data-wa data-loc="floating" target="_blank" rel="noopener">
      <Fragment set:html={ICONS.whatsapp} />
      <span>WhatsApp ile yazın</span>
    </a>
    <nav class="mbar" aria-label="Hızlı iletişim">
      <a href={SITE.phoneHref} data-loc="mobile_bar"><span class="ic-ph"><Fragment set:html={ICONS.phone} /></span>Ara</a>
      <a href={waHref} data-wa data-loc="mobile_bar" target="_blank" rel="noopener"><span class="ic-wa"><Fragment set:html={ICONS.whatsapp} /></span>WhatsApp</a>
    </nav>
    <div class="toast" role="status" aria-live="polite" id="toast"></div>
    <Consent />
    <script src="../scripts/app.js"></script>
  </body>
</html>
