---
import Base from '../layouts/Base.astro';
import { ESKI_SAYFALAR } from '../data/eski-adresler.mjs';
// Listede olmayan eski ".html" adresleri için yedek yönlendirme kuralları
const kurallar = { sayfalar: ESKI_SAYFALAR, bolge: '/bolgeye-gore-talep/', blog: '/bilgi-merkezi/' };
---
<Base title="Sayfa bulunamadı" description="Aradığınız sayfa bulunamadı." path="/404/" noindex light>
  <section class="section" style="padding-top:calc(var(--header-h) + 4rem)">
    <div class="wrap--narrow">
      <div class="sh"><h1 style="font-size:var(--step-4)">Bu sayfa bulunamadı.</h1><p>Adres değişmiş ya da yanlış yazılmış olabilir. Aşağıdaki bağlantılardan devam edebilirsiniz.</p></div>
      <div style="display:flex;flex-wrap:wrap;gap:.7rem">
        <a class="btn btn--ink" href="/">Ana sayfaya dön</a>
        <a class="btn btn--line" href="/iletisim/#gorusme">Görüşme Planlayın</a>
        <a class="btn btn--line" href="/bilgi-merkezi/">Bilgi merkezi</a>
      </div>
    </div>
  </section>
  <script is:inline define:vars={{ kurallar }}>
    (function () {
      var yol = location.pathname.replace(/^\/+/, '').toLowerCase();
      if (!/\.html?$/.test(yol)) return;
      var hedef = kurallar.sayfalar[yol.replace(/\.htm$/, '.html')]
        || (/^bolgeler\//.test(yol) && kurallar.bolge)
        || (/^(blog|makale|haber)/.test(yol) && kurallar.blog)
        || '/';
      location.replace(hedef);
    })();
  </script>
</Base>
