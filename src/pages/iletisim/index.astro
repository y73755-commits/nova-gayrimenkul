---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import LeadForm from '../../components/LeadForm.astro';
import { SITE, waUrl, waMessage } from '../../config/site.mjs';
import { orgSchema, breadcrumbSchema } from '../../data/schema.mjs';
---
<Base
  title="İletişim ve Görüşme Planlama"
  description="Nova Gayrimenkul ile görüşme planlayın: telefon 0501 701 79 08, WhatsApp veya kısa görüşme formu. Adres: Reşitpaşa, Eski Büyükdere Cd. No:2, Sarıyer/İstanbul."
  path="/iletisim/"
  waTopic="gayrimenkul danışmanlığı"
  light
  jsonLd={[orgSchema(), breadcrumbSchema([{ name: 'İletişim', path: '/iletisim/' }])]}
>
  <PageHero title="Görüşme planlayın" lead="Formu doldurun, arayın ya da WhatsApp’tan yazın. Talebinize en kısa sürede dönüş yapıyoruz." crumbs={[{ label: 'İletişim' }]} />
  <section class="section" style="padding-top:1rem" id="gorusme" aria-labelledby="gorusme-t">
    <div class="wrap grid-2" style="align-items:start">
      <div class="form-card">
        <h2 id="gorusme-t" style="font-size:var(--step-3)">Kısa görüşme formu</h2>
        <LeadForm type="gorusme" />
      </div>
      <div>
        <dl class="kv">
          <div><dt>Telefon</dt><dd><a href={SITE.phoneHref} data-loc="iletisim">{SITE.phoneDisplay}</a></dd></div>
          <div><dt>WhatsApp</dt><dd><a href={waUrl(waMessage())} data-wa data-loc="iletisim" target="_blank" rel="noopener">WhatsApp’tan yazın</a></dd></div>
          <div><dt>Adres</dt><dd>{SITE.address.full}</dd></div>
          <div><dt>Çalışma saatleri</dt><dd>{SITE.hours.label}<br />{SITE.hours.closedLabel}</dd></div>
          <div><dt>Kurucu Broker</dt><dd>{SITE.founder}</dd></div>
        </dl>
        <div style="display:flex;flex-wrap:wrap;gap:.7rem;margin-top:1.6rem">
          <a class="btn btn--ink" href={SITE.directionsUrl} data-directions data-loc="iletisim" target="_blank" rel="noopener">Yol Tarifi Al</a>
          <a class="btn btn--line" href="/mulkumu-degerlendir/">Mülkümü Değerlendir</a>
        </div>
        <p class="muted" style="margin-top:1.6rem;font-size:.95rem">Ofis görüşmeleri için önceden randevu almanızı öneririz. “Yol Tarifi Al” bağlantısı Google Haritalar’ı yeni sekmede açar.</p>
      </div>
    </div>
  </section>
</Base>
